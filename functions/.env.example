# ==============================================================================
# GREEN MILE CONSTRUCTION RD — VARIABLES DE ENTORNO Y API KEYS (BACKEND)
# Copia este archivo a functions/.env para pruebas locales o carga los secretos
# en producción con: bash scripts/configure-secrets.sh
# NUNCA subas functions/.env ni certificados .p12/.pem reales a GitHub.
# ==============================================================================

# URL pública del sitio web (para recibos, callbacks y QR)
APP_BASE_URL=https://green-mile-rd.web.app

# Clave secreta para endpoints administrativos (/api/ecf/issue, /api/payments/void, etc.)
# Si se deja vacía, se valida contra el PIN de admin_config/main en Firestore (por defecto: 2026)
ADMIN_API_SECRET=

# ------------------------------------------------------------------------------
# 1. PASARELA DE PAGOS CON TARJETA EN REPÚBLICA DOMINICANA
# Opciones: sandbox | azul | cardnet | visanet | stripe
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=sandbox

# --- AZUL (Banco Popular Dominicano — Webservices JSON + mTLS) ---
AZUL_ENV=test
AZUL_AUTH1=
AZUL_AUTH2=
AZUL_STORE_ID=
# Certificados cliente entregados por Azul codificados en Base64 (base64 -w0 cert.pem)
AZUL_CERT_BASE64=
AZUL_KEY_BASE64=
AZUL_FORCE_3DS=true

# --- CARDNET (República Dominicana — e-Commerce REST) ---
CARDNET_ENV=test
CARDNET_MERCHANT_ID=
CARDNET_TERMINAL_ID=
CARDNET_MERCHANT_TYPE=5082
CARDNET_PUBLIC_KEY=
CARDNET_PRIVATE_KEY=

# --- VISANET DOMINICANA / CYBERSOURCE (REST v2) ---
VISANET_ENV=test
VISANET_MERCHANT_ID=
VISANET_API_KEY_ID=
VISANET_API_SECRET=

# --- STRIPE (Opcional / Tarjetas Internacionales DOP o USD) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Secreto compartido para validar webhooks entrantes de pasarelas locales
PAYMENT_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 2. FACTURACIÓN ELECTRÓNICA DGII (e-CF · LEY 32-23)
# Opciones: sandbox | direct_dgii | provider_api
# ------------------------------------------------------------------------------
DGII_ECF_MODE=sandbox
# Ambiente DGII: testecf (Pre-certificación) | certecf (Certificación) | ecf (Producción)
DGII_ENV=testecf

# Datos Fiscales del Emisor (Green Mile Construction RD)
DGII_EMISOR_RNC=132050738
DGII_EMISOR_RAZON_SOCIAL=GREEN MILE CONSTRUCTION RD, S.R.L.
DGII_EMISOR_NOMBRE_COMERCIAL=GREEN MILE CONSTRUCTION RD
DGII_EMISOR_DIRECCION=Av. Winston Churchill, Ens. Piantini, Santo Domingo, D.N.
DGII_EMISOR_MUNICIPIO=010101
DGII_EMISOR_PROVINCIA=010000
DGII_EMISOR_CORREO=facturacion@greenmilerd.com

# --- Modo Directo DGII (Firma XMLDSig RSA-SHA256 con Certificado Digital .p12) ---
# Convierte tu certificado .p12 a Base64: base64 -w0 certificado_dgii.p12
DGII_CERT_P12_BASE64=
DGII_CERT_PASSWORD=

# --- Modo Proveedor API Certificado e-CF (Alternativa REST JSON) ---
ECF_PROVIDER_BASE_URL=
ECF_PROVIDER_API_KEY=
ECF_PROVIDER_SECRET=

# ------------------------------------------------------------------------------
# 3. NOTIFICACIONES AUTOMÁTICAS (CORREO ELECTRÓNICO Y WHATSAPP BUSINESS)
# ------------------------------------------------------------------------------
# Opciones EMAIL_PROVIDER: none | resend | smtp
EMAIL_PROVIDER=none
EMAIL_FROM=Green Mile RD <facturacion@greenmilerd.com>
ADMIN_NOTIFY_EMAIL=administracion@greenmilerd.com

# Resend (recomendado por simplicidad: https://resend.com)
RESEND_API_KEY=

# SMTP Tradicional (Google Workspace / Zoho / Office365)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# WhatsApp Cloud API (Meta Business)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_PHONE=18095550100
