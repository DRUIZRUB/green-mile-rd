rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /owners/{ownerId} {
      allow read: if true;
      allow create, update: if request.resource.data.rncDigits is string
                            && request.resource.data.name is string
                            && request.resource.data.passwordHash is string;
      allow delete: if false;
    }

    match /equipment/{equipmentId} {
      allow read: if true;
      allow create, update: if request.resource.data.title is string
                            && request.resource.data.city is string
                            && request.resource.data.priceDay is number;
      allow delete: if true;
    }

    match /requests/{requestId} {
      allow read: if true;
      allow create, update: if request.resource.data.title is string
                            && request.resource.data.city is string;
      allow delete: if true;
    }

    match /proposals/{proposalId} {
      allow read: if true;
      allow create, update: if request.resource.data.requestId != null
                            && request.resource.data.equipmentTitle is string
                            && request.resource.data.priceDay is number;
      allow delete: if true;
    }

    match /parts/{partId} {
      allow read: if true;
      allow create, update: if request.resource.data.title is string
                            && request.resource.data.category is string
                            && request.resource.data.price is number;
      allow delete: if true;
    }

    match /sales/{saleId} {
      allow read: if true;
      allow create, update: if request.resource.data.title is string
                            && request.resource.data.city is string
                            && request.resource.data.salePrice is number;
      allow delete: if true;
    }

    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if request.resource.data.itemTitle is string
                            && request.resource.data.buyerName is string
                            && request.resource.data.total is number;
      allow delete: if false;
    }

    match /product_chats/{msgId} {
      allow read: if true;
      allow create: if request.resource.data.itemId != null
                    && request.resource.data.senderName is string
                    && request.resource.data.message is string;
      allow update, delete: if false;
    }

    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if request.resource.data.title is string
                    && request.resource.data.renter is string
                    && request.resource.data.total is number;
      allow update: if request.resource.data.title is string
                    && request.resource.data.total is number;
      allow delete: if false;
    }

    match /payouts/{payoutId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    match /admin_config/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.equipmentId is string
                    && request.resource.data.author is string
                    && request.resource.data.comment is string
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update, delete: if false;
    }

    match /tracking/{bookingId} {
      allow read: if true;
      allow create, update: if request.resource.data.bookingId is string
                            && request.resource.data.status in ['scheduled', 'en_route', 'arrived', 'operating', 'completed'];
      allow delete: if false;
    }

    // Archivo fiscal de XML e-CF firmados (escritura exclusiva desde Cloud Functions Admin SDK)
    match /ecf_documents/{encfId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
